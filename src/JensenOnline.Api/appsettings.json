{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "Default": "Data Source=jensenonline.db"
  },
  "Jwt": {
    "Issuer": "JensenOnline.Api",
    "Audience": "JensenOnline.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "GlobalPermitPerMinute": 200,
    "AuthPermitPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7002" ]
  }
}
